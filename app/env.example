# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8222
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:8222      # becomes DOMAIN; https://… once behind DSM's reverse proxy
SSL_PROXY=0
VW_IMAGE=vaultwarden/server:latest
ADMIN_TOKEN=change-me                  # the plain admin token (kept here, mode 600, for the window's admin calls)
ADMIN_TOKEN_HASH=$$argon2id$$…         # what the container gets; $ doubled for compose, unquoted
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
