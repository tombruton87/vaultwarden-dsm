, {
    "step_title": "Accounts",
    "items": [{
        "type": "singleselect",
        "desc": "After the install, open Vaultwarden's address and create your own account first. Then decide who else may create one. Sign-ups can be switched on and off later in the Vaultwarden window; invitations from the admin page always work.",
        "subitems": [
            { "key": "wizard_signups_open", "desc": "Anyone who can reach it can create an account (switch off once yours exists)", "defaultValue": true },
            { "key": "wizard_signups_closed", "desc": "No sign-ups: I'll invite people from the admin page", "defaultValue": false }
        ]
    }]
}, {
    "step_title": "HTTPS",
    "items": [{
        "type": "singleselect",
        "desc": "The Bitwarden apps and browser extensions only talk to Vaultwarden over HTTPS, so the package serves HTTPS itself. This can be changed later in the Vaultwarden window.",
        "subitems": [
            { "key": "wizard_tls_dsm", "desc": "DSM's certificate: the system default from Control Panel → Security → Certificate (renewals are picked up daily)", "defaultValue": true },
            { "key": "wizard_tls_self", "desc": "A self-signed certificate made by the package (browsers warn once; the apps need a trusted one)", "defaultValue": false },
            { "key": "wizard_tls_off", "desc": "Plain HTTP: I'll put it behind DSM's reverse proxy myself", "defaultValue": false }
        ]
    }]
}
